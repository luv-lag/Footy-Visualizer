# Copy this file to .env and fill in a real key:
#   cp .env.example .env
#
# Get a free Roboflow API key at https://app.roboflow.com -> Settings -> API Keys.
# Only needed for frames not already in data/detection_cache/ -- the bundled
# sample frames and the demo app's example thumbnails all have cached
# detections, so the app runs without this for those.
ROBOFLOW_API_KEY=
