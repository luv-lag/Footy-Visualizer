# --- secrets ---------------------------------------------------------------
.env

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# --- virtual environments ----------------------------------------------------
# Two by design (see README): the project venv, and PnLCalib's own torch/CUDA
# venv (which also covers the SynLoc eval scripts -- a third, near-duplicate
# venv was consolidated into this one).
.venv/
vendor/PnLCalib/.venv/

# --- vendored third-party PnLCalib repo --------------------------------------
# Not committed at all: it's a real external repo (github.com/mguti97/PnLCalib,
# see its own .git/config) with ~49M of its own examples/figures assets plus
# 506M of weights -- cloned separately per the README, not forked into this
# repo's history. Only pipeline/pnlcalib_wrapper/ (our code, which imports
# from it at runtime) is ours to track.
vendor/PnLCalib/
*.pt

# --- datasets (external, large, redownloadable -- not source) ---------------
data/SoccerNet/

# --- generated / regeneratable output (never source) -------------------------
# NOTE: data/detection_cache/ is deliberately NOT listed here -- those JSONs
# are committed fixtures (tests and the demo app's example frames load them
# by exact filename to avoid needing a live Roboflow API key). Same for
# tests/fixtures/*.npy.
.cache/
eval/eval_comparison/out/
archive/outputs/

# --- editor / OS ---------------------------------------------------------------
.DS_Store
.obsidian/

# --- everything left under ai-workspace/ after the reorg move --------------
# (misc/ -- a completed practice exercise, kept locally, not for the public
# repo; memory/ -- this machine's Claude Code MCP memory store, not project
# data; football-analysis/_to_review/ -- zipped duplicates of data/SoccerNet,
# gitignored now per team decision, deletion deferred to a later cleanup)
ai-workspace/
