batch endjaw document="cad/end_jaw.mantiprt" {
  @m1 part material pla_3d_print;
  @m2 part process fdm;
  @v1 var phone_end_x:length = 84mm description="the jaw's face rests on the phone's far end; 84mm for a 166mm phone, the M6 screw (60mm) moves it in to 48mm for a 130mm phone";
  @v2 var jaw_t:length = 6mm description="jaw thickness along X";
  @v3 var screw_y:length = 4mm description="screw axis at Y = -screw_y";
  @v4 var screw_z:length = 25mm description="screw axis height";
  @d1 datum plane p_face kind=offset refs=[YZ] offset=phone_end_x;
  @s1 sketch create jaw_s on=datum:p_face {
    rectangle j center=[-5.25mm,24mm] width=9.5mm height=40mm;
    constraint distance jy a=origin b=j.br value=0.5mm along=x;
    constraint distance jz a=origin b=j.br value=4mm along=y;
  }
  @e1 extrude jaw sketch=jaw_s depth=jaw_t direction=normal_positive merge=false;
  @h1 hole screw_seat on=jaw.cap.top at=[-screw_y, screw_z] kind=blind diameter=6mm depth=1.5mm;
}
