batch pane document="cad/window_pane.mantiprt" {
  @m1 part material abs_3d_print;
  @v1 var pane_t:length = 2mm description="clear acrylic or polycarbonate sheet, laser or score cut (not printed)";
  @v2 var pane_w:length = 81.4mm description="rabbet 82mm less 0.3mm each side";
  @v3 var pane_h:length = 95.4mm description="rabbet 96mm less 0.3mm each side";
  @v4 var win_x:length = 59mm description="window centre X = -win_x";
  @v5 var win_z:length = 54mm description="window centre height";
  @v6 var y_seat:length = 10.55mm description="rabbet floor: housing front 12.75mm less the 2.2mm rabbet";

  @d1 datum plane p_seat kind=offset refs=[XZ] offset=-y_seat;
  @s1 sketch create pane_s on=datum:p_seat {
    rectangle p center=[-59mm,54mm] width=pane_w height=pane_h;
    constraint distance px a=origin b=p.center value=win_x along=x;
    constraint distance pz a=origin b=p.center value=win_z along=y;
  }
  @e1 extrude pane sketch=pane_s depth=pane_t direction=normal_negative merge=false;
  @b1 inspect bounds;
}
